POSTGRES_PASSWORD=change-me-long-random-password
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password
JWT_SECRET=replace-with-at-least-32-random-characters
# Generate a separate secret for API, Temporal worker and Runner.
RUNNER_SHARED_SECRET=replace-with-a-different-random-secret
# 64 hex chars (32 random bytes). e.g. openssl rand -hex 32
CREDENTIALS_KEY=replace-with-64-hex-characters
WEB_PORT=8080
# New model-driven Codex MCP agent runtime is enabled by default.
# Set false only for emergency rollback to the legacy chat handler.
AGENT_RUNTIME_ENABLED=true

# Optional overrides for cloud diagnostics.
# SUPABASE_DIAGNOSTICS_URL=https://eqibpyblwzdqpimyzntz.supabase.co
# SUPABASE_DIAGNOSTICS_API_KEY=sb_publishable_...
